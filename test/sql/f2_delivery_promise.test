# name: test/sql/f2_delivery_promise.test
# description: F2 censored AFT, exercised as a delivery-promise agent would use it
# group: [sql]

require anofox_bayes

#######################################
# Setup: an open shipment book
#######################################

# The question a 3PL is actually asked is "what transit time can we promise?", and the
# data it has to answer with is an *open* book: some shipments have been delivered and
# some are still moving. Dropping the shipments still in transit is the obvious thing
# to do and it is wrong in a specific direction -- the ones still moving are the slow
# ones, so throwing them away makes every lane look faster than it is. That bias is
# what the event indicator exists to remove.
#
# Times are generated by inverting the Weibull AFT quantile at spread-out
# probabilities, so the data genuinely comes from the model:
#
#     t = exp(b0 + b1 * distance + sigma * ln(-ln(1 - u)))
#
# Each lane then has a reporting horizon; a shipment still moving at its horizon is
# recorded at the horizon with delivered = 0. Horizons are staggered per shipment,
# because a real book is censored by *when each shipment was dispatched*, not by one
# shared cut-off.
statement ok
CREATE TABLE shipments AS
WITH raw AS (
    SELECT lane, b0, b1, sigma, horizon, i,
           1.0 + (i % 11) * 0.2 AS distance_100km,
           (i + 0.5) / 60.0 AS u
    FROM (VALUES
            ('HAM-ROT', 0.90, 0.25, 0.35, 4.0),
            ('BRE-ANT', 1.30, 0.25, 0.35, 5.5),
            ('DUS-MIL', 1.55, 0.30, 0.45, 7.0)
         ) AS lanes(lane, b0, b1, sigma, horizon),
         generate_series(0, 59) AS t(i)
), simulated AS (
    SELECT lane, distance_100km,
           exp(b0 + b1 * distance_100km + sigma * ln(-ln(1 - u))) AS transit_days,
           horizon + (i % 5) * 0.8 AS cut_off
    FROM raw
)
SELECT lane,
       distance_100km,
       CASE WHEN transit_days > cut_off THEN cut_off ELSE transit_days END AS days,
       CASE WHEN transit_days > cut_off THEN 0 ELSE 1 END AS delivered
FROM simulated;

query I
SELECT count(*) FROM shipments;
----
180

# The book really is censored: 50 of the 180 shipments are still moving. Asserted as a
# range rather than the exact number, because the point is that the fixture exercises
# the censored branch at all, not that it does so exactly 50 times.
query I
SELECT count(*) BETWEEN 30 AND 90 FROM shipments WHERE delivered = 0;
----
true

#######################################
# Fit: one table function call
#######################################

statement ok
CREATE TABLE draws AS
SELECT * FROM anofox_bayes_fit(
    (SELECT lane, distance_100km, days, delivered FROM shipments),
    'censored_aft',
    {'time': 'days', 'event': 'delivered', 'x': 'distance_100km',
     'group': 'lane', 'dist': 'weibull', 'draws': 2000, 'seed': 42}
);

# The draws contract, unchanged by the family: a bridged posterior is a posterior.
query II
SELECT column_name, column_type FROM (DESCRIBE draws);
----
model_id	VARCHAR
group_id	VARCHAR
chain	INTEGER
draw	INTEGER
param	VARCHAR
value	DOUBLE

# 3 lanes x (intercept, beta[distance_100km], sigma) x 2000 draws, plus the 10
# model-metadata rows.
query I
SELECT count(*) FROM draws;
----
18011

query I
SELECT count(DISTINCT model_id) FROM draws;
----
1

query I
SELECT DISTINCT param FROM draws WHERE draw >= 0 ORDER BY param;
----
beta[distance_100km]
intercept
sigma

#######################################
# The gate, and the weaker warranty
#######################################

query I
SELECT anofox_bayes_is_actionable(param, value) FROM draws;
----
true

query II
SELECT param, value FROM draws
WHERE param IN ('__n_obs__', '__n_groups__', '__n_groups_unready__', '__family__',
                '__schema_version__')
ORDER BY param;
----
__family__	2.0
__n_groups__	3.0
__n_groups_unready__	0.0
__n_obs__	180.0
__schema_version__	1.0

# The table says which model wrote it.
query I
SELECT anofox_bayes_family_text(param, value) FROM draws;
----
censored_aft

# **The warranty, on the table.** F3 and F7 are conjugate and their posteriors are
# exact; this one is a Gaussian approximation at the mode, fitted through
# anofox-statistics. A caller reading a persisted draws table can tell the two apart
# without knowing which family it came from, and must -- the numbers look identical in
# SQL and do not carry the same guarantee.
query I
SELECT value FROM draws WHERE param = '__engine__';
----
1.0

# The engine that has no closed form for this likelihood is refused rather than
# silently substituted with something that does.
statement error
SELECT * FROM anofox_bayes_fit(
    (SELECT lane, distance_100km, days, delivered FROM shipments),
    'censored_aft',
    {'time': 'days', 'event': 'delivered', 'x': 'distance_100km', 'engine': 'exact'}
);
----
exact engine cannot serve family

# Diagnostics as a single pass/fail query per parameter.
query I
SELECT count(*) FROM (
    SELECT group_id, param
    FROM draws WHERE draw >= 0
    GROUP BY group_id, param
    HAVING NOT anofox_bayes_ess_gate(value, chain, draw, 400)
);
----
0

# The scale is positive on every draw, because it is sampled on the log scale.
query I
SELECT count(*) FROM draws WHERE param = 'sigma' AND draw >= 0 AND value <= 0;
----
0

#######################################
# The decision: what transit time can we promise?
#######################################

# For a Weibull AFT the p-quantile of the transit time is closed form:
#
#     T_p = exp(intercept + beta * distance + sigma * ln(-ln(1 - p)))
#
# so a *posterior distribution over the promise itself* is a pivot and an arithmetic
# expression over the draws table. No re-fit, no extension code, and every draw of the
# promise inherits the joint uncertainty in the level, the distance effect and the
# spread -- which is the reason the posterior has to carry the correlation between
# them and not just their variances.
statement ok
CREATE TABLE promise AS
WITH wide AS (
    SELECT group_id AS lane, draw,
           max(value) FILTER (WHERE param = 'intercept')             AS a,
           max(value) FILTER (WHERE param = 'beta[distance_100km]')  AS b,
           max(value) FILTER (WHERE param = 'sigma')                 AS s
    FROM draws WHERE draw >= 0
    GROUP BY group_id, draw
)
SELECT lane, draw,
       -- The 95th percentile of transit time for a 200 km lane haul, which sits
       -- inside the observed range of the covariate (1.0 to 3.0). Predicting at a
       -- distance the lane has never run would be extrapolation, and the interval
       -- would be honest about it by being very wide.
       exp(a + b * 2.0 + s * ln(-ln(1 - 0.95))) AS p95_days
FROM wide;

query I
SELECT count(*) FROM promise;
----
6000

# Every lane gets a finite, positive promise.
query I
SELECT count(*) FROM promise WHERE NOT (p95_days > 0 AND isfinite(p95_days));
----
0

# The lanes order the way the generating parameters say they must: HAM-ROT is the
# quickest, DUS-MIL the slowest, and the gaps are large enough not to be noise.
query I
SELECT (SELECT median(p95_days) FROM promise WHERE lane = 'HAM-ROT')
     < (SELECT median(p95_days) FROM promise WHERE lane = 'BRE-ANT');
----
true

query I
SELECT (SELECT median(p95_days) FROM promise WHERE lane = 'DUS-MIL')
     > 1.3 * (SELECT median(p95_days) FROM promise WHERE lane = 'HAM-ROT');
----
true

# **The promise an agent would actually publish.** Not the median of the posterior --
# that is right half the time -- but a conservative quantile of it, so that the
# published number is one the lane beats even if the model has underestimated it.
query I
SELECT count(*) FROM (
    SELECT lane,
           quantile_cont(p95_days, 0.5)  AS central,
           quantile_cont(p95_days, 0.9)  AS conservative
    FROM promise GROUP BY lane
) WHERE NOT (conservative > central);
----
0

# **Censoring is accounted for, and it matters.** The same fit run against a book that
# pretends every shipment was delivered on the day we stopped looking gives a
# materially shorter promise on every lane -- the bias this family exists to remove,
# measured rather than asserted.
statement ok
CREATE TABLE naive_draws AS
SELECT * FROM anofox_bayes_fit(
    (SELECT lane, distance_100km, days, 1 AS delivered FROM shipments),
    'censored_aft',
    {'time': 'days', 'event': 'delivered', 'x': 'distance_100km',
     'group': 'lane', 'dist': 'weibull', 'draws': 2000, 'seed': 42}
);

# Compared on the *promise*, and on the spread -- deliberately not on the intercept.
# The intercept is the one parameter this bias does not reliably move: the downward
# pull of the truncated times and the upward pull of the shrunken spread largely
# cancel in the level. It is the scale, and the tail quantile that depends on it, that
# give the problem away.
statement ok
CREATE TABLE naive_promise AS
WITH wide AS (
    SELECT group_id AS lane, draw,
           max(value) FILTER (WHERE param = 'intercept')             AS a,
           max(value) FILTER (WHERE param = 'beta[distance_100km]')  AS b,
           max(value) FILTER (WHERE param = 'sigma')                 AS s
    FROM naive_draws WHERE draw >= 0
    GROUP BY group_id, draw
)
SELECT lane, exp(a + b * 2.0 + s * ln(-ln(1 - 0.95))) AS p95_days FROM wide;

# Every lane's promise is shorter -- i.e. more optimistic -- when the open shipments
# are treated as delivered. That optimism is exactly what would be published to a
# customer as a promise the lane then misses.
query I
SELECT count(*) FROM (
    SELECT p.lane, median(p.p95_days) AS honest,
           (SELECT median(n.p95_days) FROM naive_promise n WHERE n.lane = p.lane) AS naive
    FROM promise p GROUP BY p.lane
) WHERE NOT (naive < honest);
----
0

# ...and the mechanism is the compressed spread, which is where the bias is visible
# parameter by parameter.
query I
SELECT count(*) FROM (
    SELECT d.group_id AS lane, median(d.value) AS honest,
           (SELECT median(n.value) FROM naive_draws n
             WHERE n.param = 'sigma' AND n.group_id = d.group_id AND n.draw >= 0) AS naive
    FROM draws d WHERE d.param = 'sigma' AND d.draw >= 0
    GROUP BY d.group_id
) WHERE NOT (naive < honest);
----
0

#######################################
# Refusal: a lane where nothing has arrived yet
#######################################

# A newly opened lane whose every shipment is still in transit carries no information
# about *when* things happen. There is no shortage of rows, so the honest verdict is
# `degenerate` -- the model is not identified by this data -- and not
# `insufficient_data`, which would say the sample was thin.
statement ok
CREATE TABLE with_new_lane AS
SELECT * FROM shipments
UNION ALL
SELECT 'ZRH-OSL', 1.0 + (i % 11) * 0.2, 3.0 + (i % 4) * 0.5, 0
FROM generate_series(0, 39) AS t(i);

statement ok
CREATE TABLE mixed_draws AS
SELECT * FROM anofox_bayes_fit(
    (SELECT lane, distance_100km, days, delivered FROM with_new_lane),
    'censored_aft',
    {'time': 'days', 'event': 'delivered', 'x': 'distance_100km',
     'group': 'lane', 'draws': 2000, 'seed': 42}
);

# 4 lanes x 3 parameters x 2000 draws, plus the 11 metadata rows: the refused lane
# occupies its slots rather than vanishing from the table.
query I
SELECT count(*) FROM mixed_draws;
----
24011

query I
SELECT anofox_bayes_status_text(param, value) FROM mixed_draws;
----
degenerate

query I
SELECT NOT anofox_bayes_is_actionable(param, value) FROM mixed_draws;
----
true

# `__status__` is worst-wins on purpose -- a book of four lanes of which one is
# unidentifiable is not 75 % trustworthy. What says how much inspecting there is to do
# is the count beside it.
query II
SELECT param, value FROM mixed_draws
WHERE param IN ('__n_groups__', '__n_groups_unready__') ORDER BY param;
----
__n_groups__	4.0
__n_groups_unready__	1.0

# The refused lane comes back NULL-shaped rather than absent: an agent iterating over
# lanes sees all four, and reads which one it may not act on.
query I
SELECT count(DISTINCT group_id) FROM mixed_draws WHERE draw >= 0;
----
4

query I
SELECT count(*) FROM mixed_draws
WHERE draw >= 0 AND group_id = 'ZRH-OSL' AND value IS NOT NULL;
----
0

# ...while the lanes that did fit are untouched by their neighbour's failure.
query I
SELECT count(*) FROM mixed_draws
WHERE draw >= 0 AND group_id <> 'ZRH-OSL' AND value IS NULL;
----
0

#######################################
# Reproducibility
#######################################

# Same inputs, same model_id and the same numbers: an auditor can re-run the promise
# and check it. The data fingerprint is taken over the rows the bridged fit actually
# read, which is what lets a fit performed inside another crate participate in
# `model_id` at all.
query I
SELECT (SELECT DISTINCT model_id FROM draws)
     = (SELECT DISTINCT model_id FROM anofox_bayes_fit(
            (SELECT lane, distance_100km, days, delivered FROM shipments), 'censored_aft',
            {'time': 'days', 'event': 'delivered', 'x': 'distance_100km',
             'group': 'lane', 'dist': 'weibull', 'draws': 2000, 'seed': 42}));
----
true

query I
SELECT count(*) = 0 FROM (
    SELECT * FROM draws
    EXCEPT ALL
    SELECT * FROM anofox_bayes_fit(
        (SELECT lane, distance_100km, days, delivered FROM shipments), 'censored_aft',
        {'time': 'days', 'event': 'delivered', 'x': 'distance_100km',
         'group': 'lane', 'dist': 'weibull', 'draws': 2000, 'seed': 42})
);
----
true

# A different error distribution is a different model, even at the same seed and over
# the same rows: `dist` is part of the canonical config and therefore of the identity.
query I
SELECT (SELECT DISTINCT model_id FROM draws)
    != (SELECT DISTINCT model_id FROM anofox_bayes_fit(
            (SELECT lane, distance_100km, days, delivered FROM shipments), 'censored_aft',
            {'time': 'days', 'event': 'delivered', 'x': 'distance_100km',
             'group': 'lane', 'dist': 'lognormal', 'draws': 2000, 'seed': 42}));
----
true

#######################################
# Configuration is validated before anything is computed
#######################################

statement error
SELECT * FROM anofox_bayes_fit(
    (SELECT lane, distance_100km, days, delivered FROM shipments), 'censored_aft',
    {'time': 'days', 'event': 'delivered', 'dst': 'weibull'});
----
did you mean 'dist'

statement error
SELECT * FROM anofox_bayes_fit(
    (SELECT lane, distance_100km, days, delivered FROM shipments), 'censored_aft',
    {'time': 'days', 'event': 'delivered', 'dist': 'gompertz'});
----
expected one of weibull

# A non-positive duration is a malformed request rather than weak evidence: it names
# the column so the caller can repair it, instead of arriving as a status an agent
# might read as "the data was thin this month".
statement error
SELECT * FROM anofox_bayes_fit(
    (SELECT lane, distance_100km, 0.0 AS days, delivered FROM shipments), 'censored_aft',
    {'time': 'days', 'event': 'delivered', 'x': 'distance_100km'});
----
strictly positive
