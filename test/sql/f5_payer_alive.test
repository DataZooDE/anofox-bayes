  (534,2,6.1001,26.9772),(535,0,0.0000,23.5214),(536,1,7.4155,46.5715),(537,0,0.0000,30.5327),(538,11,30.1672,45.2408),(539,3,0.5787,34.2236),
  (540,3,15.3675,52.6219),(541,1,11.3614,55.5727),(542,8,16.8671,48.3833),(543,1,1.1607,27.2528),(544,1,12.1419,27.7845),(545,7,43.2889,76.1256),
  (546,6,30.7235,38.5368),(547,7,60.8081,75.0591),(548,1,1.2061,44.7509),(549,0,0.0000,63.6663),(550,2,35.8835,44.6442),(551,1,13.0689,29.9955),
  (552,4,22.8114,66.2710),(553,0,0.0000,54.1507),(554,1,23.7651,68.2322),(555,1,41.3272,61.7448),(556,3,13.7502,24.0319),(557,7,35.2005,47.8330),
  (558,1,2.2365,63.9478),(559,1,0.5552,43.4202),(560,4,19.6183,25.7988),(561,1,26.0382,45.7973),(562,1,1.0816,57.7270),(563,1,24.2874,38.8707),
  (564,5,33.7857,33.9842),(565,1,29.1065,35.2606),(566,1,9.1773,74.9808),(567,2,9.4938,51.7010),(568,1,16.8012,20.5990),(569,4,37.8216,55.0427),
  (570,4,29.4742,38.2445),(571,1,7.3627,71.5695),(572,4,49.8113,53.0079),(573,1,2.7535,42.2530),(574,2,13.1369,64.4450),(575,1,0.2975,74.1821),
  (576,3,19.2919,28.4867),(577,1,6.0591,70.7176),(578,2,11.5369,50.5686),(579,0,0.0000,45.9122),(580,1,32.6392,44.4878),(581,1,7.6056,24.4918),
  (582,2,5.8177,55.6445),(583,1,3.1418,60.4680),(584,1,25.9149,66.6349),(585,1,17.3747,68.7101),(586,3,33.8196,35.6575),(587,2,2.0465,27.3795),
  (588,3,16.6037,38.1998),(589,2,26.4423,47.2817),(590,6,20.9722,24.6140),(591,2,8.8266,42.2053),(592,1,5.2232,52.2341),(593,5,53.8018,58.1375),
  (594,1,35.5159,66.0616),(595,2,5.8263,54.5328),(596,0,0.0000,31.5948),(597,0,0.0000,20.0013),(598,1,4.3508,28.3806),(599,0,0.0000,33.8768)
;

#######################################
# Fit: one table function call, four numbers out
#######################################

# The fit is over the *population*, not over customers: BG/NBD's four parameters
# describe how the whole base transacts and how it churns, and every individual
# account is scored against them afterwards. That is what keeps a 600-row fit and a
# 600 000-row fit the same size of answer.
statement ok
CREATE TABLE draws AS
SELECT * FROM anofox_bayes_fit(
    (SELECT frequency, recency, age FROM payers),
    'payer_alive',
    {'frequency': 'frequency', 'recency': 'recency', 'age': 'age',
     'draws': 4000, 'seed': 42}
);

# The draws contract, unchanged: (model_id, group_id, chain, draw, param, value).
query II
SELECT column_name, column_type FROM (DESCRIBE draws);
----
model_id	VARCHAR
group_id	VARCHAR
chain	INTEGER
draw	INTEGER
param	VARCHAR
value	DOUBLE

# 4 population parameters x 4000 draws, plus the 10 model-metadata rows.
query I
SELECT count(*) FROM draws;
----
16010

query I
SELECT count(DISTINCT model_id) FROM draws;
----
1

# Every parameter is population level, so there is exactly one group and its key is
# the contract's `__global__` sentinel. This is the property the whole rescoring
# recipe below rests on: the draws do not mention any customer, so they can be joined
# against *any* customer list, including one that did not exist when the fit ran.
query II
SELECT DISTINCT group_id, count(DISTINCT param) FROM draws WHERE draw >= 0 GROUP BY group_id;
----
__global__	4

query I
SELECT string_agg(DISTINCT param, ',' ORDER BY param) FROM draws WHERE draw >= 0;
----
a,alpha,b,r

#######################################
# The gate: is this fit safe to act on?
#######################################

query I
SELECT value = 0 FROM draws WHERE param = '__status__';
----
true

query II
SELECT param, value FROM draws
WHERE param IN ('__n_obs__', '__n_groups__', '__n_groups_unready__', '__family__',
                '__engine__', '__schema_version__')
ORDER BY param;
----
__engine__	1.0
__family__	5.0
__n_groups__	1.0
__n_groups_unready__	0.0
__n_obs__	600.0
__schema_version__	1.0

# `__engine__` is 1 -- laplace. This family has no closed form, so unlike the other two
# there is no exact engine to fall back on, and the table says so rather than leaving a
# reader to assume.
query I
SELECT anofox_bayes_family_text(param, value) FROM draws;
----
payer_alive

query I
SELECT count(*) FROM (
    SELECT group_id, param
    FROM draws WHERE draw >= 0
    GROUP BY group_id, param
    HAVING NOT anofox_bayes_ess_gate(value, chain, draw, 400)
);
----
0

# The base was drawn from r = 1.2, alpha = 10, a = 1.5, b = 2.0. Ranges rather than
# pinned quantiles: the exact numbers are pinned in the Rust suite, where they can be
# regenerated, and what belongs here is that the fit recovers the process it was given.
query IIII
SELECT median(value) FILTER (WHERE param = 'r')     BETWEEN 0.9 AND 1.5,
       median(value) FILTER (WHERE param = 'alpha') BETWEEN 7.0 AND 13.0,
       median(value) FILTER (WHERE param = 'a')     BETWEEN 0.6 AND 2.2,
       median(value) FILTER (WHERE param = 'b')     BETWEEN 0.7 AND 3.0
FROM draws WHERE draw >= 0;
----
true	true	true	true

#######################################
# The decision: who is still a payer?
#######################################

# One row per posterior draw, with the four parameters side by side. This is the only
# reshaping the rescoring needs, and it is done once.
statement ok
CREATE TABLE population AS
SELECT draw,
       max(value) FILTER (WHERE param = 'r')     AS r,
       max(value) FILTER (WHERE param = 'alpha') AS alpha,
       max(value) FILTER (WHERE param = 'a')     AS a,
       max(value) FILTER (WHERE param = 'b')     AS b
FROM draws WHERE draw >= 0 GROUP BY draw;

# **P(alive), as pure SQL over the draws.** No re-fit, no extension call in the
# expression itself -- just arithmetic on four population numbers and the three
# statistics the customer already has. That is the whole operating premise of this
# family: today's dunning list is scored from yesterday's draws.
#
# The expression is the one published as `P_ALIVE_SQL` in the Rust crate, character for
# character, and a unit test asserts that this file still contains it.
statement ok
CREATE TABLE alive AS
SELECT p.customer_id,
       p.frequency,
       p.age - p.recency AS weeks_silent,
       avg(1.0 / (1.0 + CASE WHEN frequency = 0 THEN 0.0 ELSE (a / (b + frequency - 1)) * pow((alpha + age) / (alpha + recency), r + frequency) END)) AS p_alive
FROM payers p CROSS JOIN population d
GROUP BY p.customer_id, p.frequency, p.age, p.recency;

query I
SELECT count(*) FROM alive;
----
600

# Every score is a probability. A NULL or an out-of-range value here would mean the
# arithmetic broke somewhere in the tails, which is exactly where the heavy buyers with
# long windows live.
query I
SELECT count(*) = 0 FROM alive WHERE p_alive IS NULL OR p_alive < 0.0 OR p_alive > 1.0;
----
true

# **The headline: lapsed payers score low, and payers still paying score high.**
#
# Nothing in the input said which accounts had lapsed -- the cohorts below are cut
# purely on how long each account has been silent, and the model never saw that
# variable. It saw three numbers per customer and worked out what silence means for a
# customer who used to buy at *that* rate, which is the part a rule of thumb cannot do.
query IIII
SELECT
  avg(p_alive) FILTER (WHERE frequency > 0 AND weeks_silent > 40) < 0.10 AS lapsed_are_written_off,
  max(p_alive) FILTER (WHERE frequency > 0 AND weeks_silent > 40) < 0.30 AS none_of_them_survives,
  avg(p_alive) FILTER (WHERE frequency > 0 AND weeks_silent <= 5) > 0.65 AS recent_payers_are_kept,
  min(p_alive) FILTER (WHERE frequency > 0 AND weeks_silent <= 5) > 0.30 AS none_of_them_written_off
FROM alive;
----
true	true	true	true

# ...and the two cohorts are cleanly separated on average, in the right direction.
query I
SELECT (SELECT avg(p_alive) FROM alive WHERE frequency > 0 AND weeks_silent <= 5)
     > 5 * (SELECT avg(p_alive) FROM alive WHERE frequency > 0 AND weeks_silent > 40);
----
true

# An account that never repeated scores 1.0 exactly, and that is the model being
# careful rather than optimistic: dropping out is something that can only happen
# *after* a transaction, so a customer with one payment has had no opportunity to
# churn and the data contains no evidence either way. The uncertainty about such an
# account lives in its transaction rate, not in whether it is alive.
query I
SELECT bool_and(p_alive = 1.0) FROM alive WHERE frequency = 0;
----
true

# The dunning list an agent would actually produce: accounts still worth chasing.
# Ordering is the useful output, not a threshold -- the threshold belongs to whoever
# owns the cost of a letter against the value of a recovery.
query III
SELECT customer_id, frequency, round(weeks_silent, 1)
FROM alive
WHERE frequency > 0
ORDER BY p_alive ASC, customer_id
LIMIT 5;
----
14	5	62.6
278	7	55.9
163	5	66.2
335	5	44.4
17	24	28.2

# Note the last of those: 24 payments and only 28 weeks of silence, ranked below
# accounts silent for twice as long. That is the model working. A customer who paid 24
# times in a year has a rate that makes 28 quiet weeks overwhelming evidence, while the
# same gap from an account that paid five times means much less. A days-since-last-
# payment rule cannot express that, and it is the reason this family exists.

#######################################
# The SQL expression against its Rust closed form
#######################################

# The same five cases the Rust test `p_alive_matches_its_closed_form` pins, evaluated
# by the published SQL expression at literal parameter values. No fit is involved, so
# this is a direct comparison of two implementations of one formula -- and the values
# on the right are the constants that appear in the Rust source.
query I
SELECT bool_and(abs(1.0 / (1.0 + CASE WHEN frequency = 0 THEN 0.0 ELSE (a / (b + frequency - 1)) * pow((alpha + age) / (alpha + recency), r + frequency) END) - expected) < 1e-9)
FROM (VALUES
    (0.9, 12.0, 1.1, 3.0, 0, 0.0,  40.0, 1.0),
    (0.9, 12.0, 1.1, 3.0, 6, 39.0, 40.0, 0.8641443110059065),
    (0.9, 12.0, 1.1, 3.0, 6, 8.0,  40.0, 0.009864516991833232),
    (0.9, 12.0, 1.1, 3.0, 1, 5.0,  40.0, 0.2458340720809729),
    (0.9, 12.0, 1.1, 3.0, 6, 8.0,  10.0, 0.7902596327648121)
) AS t(r, alpha, a, b, frequency, recency, age, expected);
----
true

#######################################
# Reproducibility
#######################################

query I
SELECT (SELECT DISTINCT model_id FROM draws)
     = (SELECT DISTINCT model_id FROM anofox_bayes_fit(
            (SELECT frequency, recency, age FROM payers), 'payer_alive',
            {'frequency': 'frequency', 'recency': 'recency', 'age': 'age',
             'draws': 4000, 'seed': 42}));
----
true

query I
SELECT count(*) = 0 FROM (
    SELECT * FROM draws
    EXCEPT ALL
    SELECT * FROM anofox_bayes_fit(
        (SELECT frequency, recency, age FROM payers), 'payer_alive',
        {'frequency': 'frequency', 'recency': 'recency', 'age': 'age',
         'draws': 4000, 'seed': 42})
);
----
true

#######################################
# Refusal: a base in which nobody has ever been seen to stop
#######################################

# Truncate every repeat payer's observation window at their last payment -- the shape
# a snapshot taken at the renewal date produces. Nobody in this table has ever gone
# quiet, so nothing in it says how often payers drop out, and BG/NBD's likelihood is
# then maximised only in the limit of a zero dropout probability.
#
# The fit succeeds, the status refuses, and the draws are NULL. A curvature computed
# at a runaway point is not a posterior, and an interval derived from it would be
# confident and meaningless.
statement ok
CREATE TABLE never_lapsed AS
SELECT customer_id, frequency, recency,
       CASE WHEN frequency > 0 THEN recency ELSE age END AS age
FROM payers;

statement ok
CREATE TABLE refused AS
SELECT * FROM anofox_bayes_fit(
    (SELECT frequency, recency, age FROM never_lapsed),
    'payer_alive',
    {'frequency': 'frequency', 'recency': 'recency', 'age': 'age', 'draws': 1000});

# 1 = degenerate
query I
SELECT value FROM refused WHERE param = '__status__';
----
1.0

query I
SELECT anofox_bayes_is_actionable(param, value) FROM refused;
----
false

query I
SELECT bool_and(value IS NULL) FROM refused WHERE draw >= 0;
----
true

# The documented way out: a proper prior supplies what the data does not, and the same
# base becomes fittable. It is a real modelling choice with real consequences -- the
# answer is now partly the prior's -- which is why it is opt-in rather than a default.
query I
SELECT value = 0 FROM anofox_bayes_fit(
    (SELECT frequency, recency, age FROM never_lapsed),
    'payer_alive',
    {'frequency': 'frequency', 'recency': 'recency', 'age': 'age', 'draws': 1000,
     'prior': {'r':     {'log_mean': 0.0, 'log_sd': 0.7},
               'alpha': {'log_mean': 2.5, 'log_sd': 1.0},
               'a':     {'log_mean': 0.0, 'log_sd': 0.7},
               'b':     {'log_mean': 0.7, 'log_sd': 1.0}}})
WHERE param = '__status__';
----
true

#######################################
# Errors are precise and arrive before any computation
#######################################

statement error
SELECT * FROM anofox_bayes_fit((SELECT frequency, recency, age FROM payers), 'payer_alive', {'frequency': 'frequency'});
----
recency

statement error
SELECT * FROM anofox_bayes_fit((SELECT frequency, recency, age FROM payers), 'payer_alive', {'frequency': 'frequency', 'recncy': 'recency', 'age': 'age'});
----
did you mean 'recency'

statement error
SELECT * FROM anofox_bayes_fit((SELECT frequency, recency, age FROM payers), 'payer_alive', {'frequency': 'frequency', 'recency': 'age', 'age': 'recency'});
----
recency

statement error
SELECT * FROM anofox_bayes_fit((SELECT frequency, recency, age FROM payers), 'payer_alive', {'frequency': 'frequency', 'recency': 'recency', 'age': 'age', 'prior': {'r': {'sd': 1.0}}});
----
prior.r.sd

# This family has no closed-form posterior, so the exact engine declines rather than
# quietly substituting an approximation.
statement error
SELECT * FROM anofox_bayes_fit((SELECT frequency, recency, age FROM payers), 'payer_alive', {'frequency': 'frequency', 'recency': 'recency', 'age': 'age', 'engine': 'exact'});
----
payer_alive
