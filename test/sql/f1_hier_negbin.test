query I
SELECT count(*) FROM issues;
----
280

# Six thick parts, eight thin ones.
query II
SELECT count(*) FILTER (WHERE n >= 40), count(*) FILTER (WHERE n = 5)
FROM (SELECT part, count(*) AS n FROM issues GROUP BY part);
----
6	8

#######################################
# Fit: one table function call
#######################################

# Partial pooling is the whole reason this is one fit and not fourteen. Each part gets
# its own rate, and each rate is pulled toward what the rest of the catalogue does by
# an amount the data decides: hardly at all for a bearing with forty weeks, most of
# the way for a seal with five.
statement ok
CREATE TABLE draws AS
SELECT * FROM anofox_bayes_fit(
    (SELECT units, part FROM issues),
    'hier_negbin',
    {'y': 'units', 'group': 'part', 'draws': 1000, 'chains': 4, 'seed': 42}
);

# The draws contract, unchanged: (model_id, group_id, chain, draw, param, value).
query II
SELECT column_name, column_type FROM (DESCRIBE draws);
----
model_id	VARCHAR
group_id	VARCHAR
chain	INTEGER
draw	INTEGER
param	VARCHAR
value	DOUBLE

# 31 parameters (intercept, tau, phi, plus u and rate for each of fourteen parts)
# x 4 chains x 1000 draws, plus four NUTS sampler statistics per draw, plus the 11
# model-metadata rows.
query I
SELECT count(*) FROM draws;
----
140011

query I
SELECT string_agg(DISTINCT param, ',' ORDER BY param)
FROM draws WHERE draw >= 0 AND group_id = '__global__' AND param NOT LIKE '\_\_%' ESCAPE '\';
----
intercept,phi,tau

#######################################
# The gate: is this fit safe to act on?
#######################################

query I
SELECT anofox_bayes_status_text(param, value) FROM draws;
----
converged

query I
SELECT anofox_bayes_family_text(param, value) FROM draws;
----
hier_negbin

query II
SELECT param, value FROM draws
WHERE param IN ('__n_obs__', '__n_groups__', '__n_groups_unready__', '__engine__',
                '__schema_version__', '__n_chains__')
ORDER BY param;
----
__engine__	2.0
__n_chains__	4.0
__n_groups__	14.0
__n_groups_unready__	0.0
__n_obs__	280.0
__schema_version__	1.0

# `__engine__` is 2 -- NUTS. A hierarchical pooling scale has no closed form and no
# usable joint mode, so this family is sampled rather than approximated, and the
# table says which.

# NUTS is a Markov chain, so R-hat is a real statistic here rather than NULL, and both
# gates have to pass for every parameter.
query I
SELECT count(*) FROM (
    SELECT group_id, param
    FROM draws WHERE draw >= 0 AND param NOT LIKE '\_\_%' ESCAPE '\'
    GROUP BY group_id, param
    HAVING NOT anofox_bayes_ess_gate(value, chain, draw, 400)
        OR NOT anofox_bayes_rhat_gate(value, chain, draw, 1.01)
);
----
0

# A divergent trajectory means the sampler left the region it was exploring, so the
# draws around it are not from the posterior. There is no acceptable budget.
query I
SELECT coalesce(sum(value), 0) FROM draws WHERE param = '__divergent__';
----
0.0

# The process the table was drawn from, recovered. Ranges rather than pinned
# quantiles: the exact numbers are pinned in the Rust suite where they can be
# regenerated, and what belongs here is that the fit found the process it was given.
query III
SELECT median(value) FILTER (WHERE param = 'intercept') BETWEEN 1.3 AND 2.3,
       median(value) FILTER (WHERE param = 'tau')       BETWEEN 0.4 AND 1.3,
       median(value) FILTER (WHERE param = 'phi')       BETWEEN 1.2 AND 5.0
FROM draws WHERE draw >= 0;
----
true	true	true

#######################################
# Partial pooling, visible
#######################################

# The five-week seals are shrunk toward the catalogue; the forty-week bearings are
# not. Compare each part's posterior median rate against its own sample mean: the
# thin parts move, the thick ones stay.
statement ok
CREATE TABLE shrinkage AS
SELECT d.group_id AS part,
       median(d.value) AS posterior_rate,
       any_value(s.sample_mean) AS sample_mean,
       any_value(s.n) AS weeks
FROM draws d
JOIN (SELECT part, avg(units) AS sample_mean, count(*) AS n FROM issues GROUP BY part) s
  ON s.part = d.group_id
WHERE d.param = 'rate' AND d.draw >= 0
GROUP BY d.group_id;

query I
SELECT count(*) FROM shrinkage;
----
14

# Thin parts are pulled a long way; thick parts are barely touched. `abs(log ratio)`
# rather than a difference, because the parts differ by an order of magnitude in level
# and a difference would only measure that.
query II
SELECT avg(abs(ln(posterior_rate / sample_mean))) FILTER (WHERE weeks = 5)  > 0.05,
       avg(abs(ln(posterior_rate / sample_mean))) FILTER (WHERE weeks = 40) < 0.05
FROM shrinkage;
----
true	true

#######################################
# The decision: a reorder point at a stated service level
#######################################

# This is the query the agent runs, and it is pure SQL over the draws -- no re-fit,
# and no random numbers.
#
# The posterior predictive for next week's demand on a part is a *mixture* of
# negative binomials, one per posterior draw. Its probability mass function is
# available in closed form, so the whole distribution can be summed rather than
# simulated:
#
#   P(Y = k | rate, phi) = exp( lgamma(k + phi) - lgamma(phi) - lgamma(k + 1)
#                               + phi * ln(phi / (phi + rate))
#                               + k   * ln(rate / (phi + rate)) )
#
# Averaging that over the draws integrates out every parameter at once -- the level,
# the part's own offset, the pooling scale and the dispersion -- which is precisely
# what a plug-in estimate at a point cannot do, and precisely why a thin part's
# interval comes out honest.
statement ok
CREATE TABLE predictive AS
SELECT r.group_id AS part, k.k,
       avg(exp(lgamma(k.k + p.value) - lgamma(p.value) - lgamma(k.k + 1)
               + p.value * ln(p.value / (p.value + r.value))
               + k.k * ln(r.value / (p.value + r.value)))) AS pmf
FROM (SELECT group_id, chain, draw, value FROM draws WHERE param = 'rate' AND draw >= 0) r
JOIN (SELECT chain, draw, value FROM draws WHERE param = 'phi' AND draw >= 0) p
  USING (chain, draw)
CROSS JOIN (SELECT range AS k FROM range(0, 201)) k
GROUP BY r.group_id, k.k;

# It is a distribution: the mass over 0..200 accounts for essentially everything.
query I
SELECT min(total) > 0.999 FROM (SELECT part, sum(pmf) AS total FROM predictive GROUP BY part);
----
true

# The reorder point: the smallest whole number of units that covers next week's demand
# with the stated probability.
statement ok
CREATE TABLE reorder AS
SELECT part, service_level,
       min(k) FILTER (WHERE cdf >= service_level) AS reorder_point
FROM (
    SELECT part, k, sum(pmf) OVER (PARTITION BY part ORDER BY k) AS cdf FROM predictive
) CROSS JOIN (SELECT unnest([0.90, 0.95, 0.99]) AS service_level)
GROUP BY part, service_level;

query I
SELECT count(*) = 42 AND count(*) FILTER (WHERE reorder_point IS NULL) = 0 FROM reorder;
----
true

# A higher service level never asks for less stock.
query I
SELECT count(*) = 0 FROM (
    SELECT part FROM reorder
    GROUP BY part
    HAVING max(reorder_point) FILTER (WHERE service_level = 0.90)
         > min(reorder_point) FILTER (WHERE service_level = 0.99)
);
----
true

# **The headline, and the reason this family is native rather than bridged.**
#
# For a part with five weeks of history the reorder point has to carry three
# uncertainties at once: how much this part moves, how much parts in general vary, and
# how bursty demand is week to week. A plug-in estimate at a point drops the last two
# and reports a reorder point that is too low -- the part stocks out more often than
# the service level printed on the report, and nothing downstream can tell.
#
# Here the thin parts are stocked *more* deeply relative to what they have been seen
# to use than the thick ones, which is what paying for uncertainty looks like.
query I
SELECT
  avg(r.reorder_point / s.sample_mean) FILTER (WHERE s.weeks = 5)
> avg(r.reorder_point / s.sample_mean) FILTER (WHERE s.weeks = 40)
FROM reorder r JOIN shrinkage s ON s.part = r.part
WHERE r.service_level = 0.95;
----
true

# ...and every part's 95% reorder point is above its own observed average demand,
# which a point forecast would not guarantee.
query I
SELECT count(*) = 0
FROM reorder r JOIN shrinkage s ON s.part = r.part
WHERE r.service_level = 0.95 AND r.reorder_point <= s.sample_mean;
----
true

# The plan a planner would receive, for the seals -- the parts nobody has enough data
# on. Those true rates were 25.2 a week for `SEA-210` and 3.2 for `SEA-212`, on five
# weeks each, and the model separates them without being told which is which.
query II
SELECT part, reorder_point
FROM reorder
WHERE service_level = 0.95 AND part LIKE 'SEA-%'
ORDER BY part;
----
SEA-206	23
SEA-207	19
SEA-208	12
SEA-209	17
SEA-210	51
SEA-211	25
SEA-212	10
SEA-213	35

# Each of those parts' posterior rate sits where its own history says it should,
# having been pulled toward the catalogue by an amount the data chose. (The true rates
# were 6.8, 6.9, 2.9, 3.3, 25.2, 7.0, 3.2 and 16.8.)
query I
SELECT count(*) = 0 FROM shrinkage
WHERE weeks = 5 AND (posterior_rate < 0.6 * sample_mean OR posterior_rate > 1.6 * sample_mean);
----
true

#######################################
# Reproducibility
#######################################

query I
SELECT count(*) = 0 FROM (
    SELECT * FROM draws
    EXCEPT ALL
    SELECT * FROM anofox_bayes_fit(
        (SELECT units, part FROM issues), 'hier_negbin',
        {'y': 'units', 'group': 'part', 'draws': 1000, 'chains': 4, 'seed': 42})
);
----
true

#######################################
# Refusal
#######################################

# A part list with two parts on it. A pooling scale estimated from two groups
# describes the sample, not the catalogue, and every per-part interval inherits that.
query I
SELECT anofox_bayes_status_text(param, value) FROM anofox_bayes_fit(
    (SELECT units, part FROM issues WHERE part IN ('BRG-100', 'BRG-101')),
    'hier_negbin',
    {'y': 'units', 'group': 'part', 'draws': 200, 'chains': 2, 'seed': 1});
----
insufficient_data

# A part nobody has ever issued. There is no interior maximum -- the rate is
# identified only in the limit of zero -- so the fit refuses and the draws are NULL.
statement ok
CREATE TABLE never_issued AS
SELECT part, week, 0 AS units FROM issues WHERE week <= 5;

# `param NOT LIKE '__%'` excludes the four NUTS sampler-statistic rows, which carry
# real numbers on a refused fit -- they describe the sampler, not the model.
query II
SELECT anofox_bayes_status_text(param, value),
       bool_and(value IS NULL) FILTER (WHERE draw >= 0 AND param NOT LIKE '\_\_%' ESCAPE '\')
FROM anofox_bayes_fit(
    (SELECT units, part FROM never_issued), 'hier_negbin',
    {'y': 'units', 'group': 'part', 'draws': 200, 'chains': 2, 'seed': 1});
----
degenerate	true

#######################################
# Errors are precise and arrive before any computation
#######################################

statement error
SELECT * FROM anofox_bayes_fit((SELECT units, part FROM issues), 'hier_negbin', {'y': 'units'});
----
group

statement error
SELECT * FROM anofox_bayes_fit((SELECT units, part FROM issues), 'hier_negbin', {'y': 'units', 'grp': 'part'});
----
did you mean 'group'

statement error
SELECT * FROM anofox_bayes_fit((SELECT units, part FROM issues), 'hier_negbin', {'y': 'units', 'group': 'part', 'likelihood': 'gaussian'});
----
negbinomial

# A prior mean with no spread is not a prior, and defaulting the spread would invent
# one on the caller's behalf.
statement error
SELECT * FROM anofox_bayes_fit((SELECT units, part FROM issues), 'hier_negbin', {'y': 'units', 'group': 'part', 'prior': {'phi': {'log_mean': 1.0}}});
----
prior.phi.log_sd

# The Laplace engine is refused rather than served badly: a Gaussian at the joint mode
# of a non-centred hierarchy is not a posterior, because the likelihood does not
# depend on the pooling scale at all when every group offset is zero.
statement error
SELECT * FROM anofox_bayes_fit((SELECT units, part FROM issues), 'hier_negbin', {'y': 'units', 'group': 'part', 'engine': 'laplace'});
----
NUTS only

# A fractional response is a data-preparation mistake, not a count.
statement error
SELECT * FROM anofox_bayes_fit((SELECT units + 0.5 AS units, part FROM issues), 'hier_negbin', {'y': 'units', 'group': 'part'});
----
whole count
