# name: test/sql/refusal_semantics.test
# description: BR-5 -- degenerate inputs never produce silent bad numbers
# group: [sql]

require anofox_bayes

# The property this file exists to defend: for EVERY degenerate input below, the
# outcome is either a precise error or a fit whose status refuses. What must never
# happen is a converged status alongside a number an agent would act on.

statement ok
CREATE TABLE ok_data AS
SELECT 'A' AS grp, i AS x, 2.0 + 0.5 * i + ((i % 5) - 2) * 0.3 AS y
FROM generate_series(0, 39) AS t(i);

#######################################
# The happy path, for contrast
#######################################

query II
SELECT anofox_bayes_status_text(param, value),
       anofox_bayes_is_actionable(param, value)
FROM anofox_bayes_fit((SELECT x, y FROM ok_data), 'pooled_gaussian',
                      {'y': 'y', 'x': 'x', 'draws': 2000});
----
converged	true

#######################################
# Degenerate input 1: a group with a single observation
#######################################

statement ok
CREATE TABLE solo AS
SELECT * FROM (VALUES ('A', 1.0), ('A', 1.1), ('A', 0.9), ('A', 1.05), ('SOLO', 42.0))
AS t(grp, v);

query II
SELECT anofox_bayes_status_text(param, value),
       anofox_bayes_is_actionable(param, value)
FROM anofox_bayes_fit((SELECT grp, v FROM solo), 'conjugate_anomaly',
                      {'value': 'v', 'group': 'grp', 'draws': 1000});
----
insufficient_data	false

# The verdict above covers both lanes, deliberately: a fit an agent must inspect is
# not half trustworthy. `__n_groups_unready__` says how much of it there is to
# inspect -- one lane out of two -- without softening the verdict.
query II
SELECT max(value) FILTER (WHERE param = '__n_groups_unready__'),
       max(value) FILTER (WHERE param = '__n_groups__')
FROM anofox_bayes_fit((SELECT grp, v FROM solo), 'conjugate_anomaly',
                      {'value': 'v', 'group': 'grp', 'draws': 1000});
----
1.0	2.0

# ...and which lane, which is what an agent actually needs. `__n_groups_unready__`
# sends it looking; `__group_status__` says where. On a 5 000-lane fit that is the
# difference between quarantining three lanes and quarantining the table.
statement ok
CREATE TABLE solo_draws AS
SELECT * FROM anofox_bayes_fit((SELECT grp, v FROM solo), 'conjugate_anomaly',
                               {'value': 'v', 'group': 'grp', 'draws': 1000});

query II
SELECT group_id, anofox_bayes_status_name(value)
FROM solo_draws WHERE param = '__group_status__' ORDER BY group_id;
----
SOLO	insufficient_data

# The count and the names are two ways of saying the same thing, so they must agree.
query I
SELECT (SELECT count(*) FROM solo_draws WHERE param = '__group_status__')
     = (SELECT max(value) FROM solo_draws WHERE param = '__n_groups_unready__');
----
true

# A refused lane is named AND still occupies its draw slots as NULL -- it does not
# vanish from the table, so a join against it stays total.
query II
SELECT count(*), count(value)
FROM solo_draws WHERE param = 'mu' AND group_id = 'SOLO' AND draw >= 0;
----
1000	0

# The healthy lane is untouched by its neighbour's refusal.
query I
SELECT count(*) = 1000 AND count(value) = 1000
FROM solo_draws WHERE param = 'mu' AND group_id = 'A' AND draw >= 0;
----
true

#######################################
# Degenerate input 2: zero variance
#######################################

statement ok
CREATE TABLE constant AS SELECT 7.0 AS v FROM generate_series(1, 30);

query I
SELECT anofox_bayes_is_actionable(param, value)
FROM anofox_bayes_fit((SELECT v FROM constant), 'conjugate_anomaly',
                      {'value': 'v', 'draws': 1000});
----
false

#######################################
# Degenerate input 3: a perfectly explained response
#######################################

statement ok
CREATE TABLE perfect AS SELECT i AS x, 3.0 + 2.0 * i AS y FROM generate_series(0, 19) AS t(i);

query I
SELECT anofox_bayes_is_actionable(param, value)
FROM anofox_bayes_fit((SELECT x, y FROM perfect), 'pooled_gaussian',
                      {'y': 'y', 'x': 'x', 'draws': 1000});
----
false

#######################################
# Degenerate input 4: collinear predictors
#######################################

statement error
SELECT * FROM anofox_bayes_fit(
    (SELECT x, x * 2 AS x_dup, y FROM ok_data), 'pooled_gaussian',
    {'y': 'y', 'x': ['x', 'x_dup'], 'draws': 500});
----
singular or rank-deficient

#######################################
# Degenerate input 5: more parameters than observations
#######################################

statement error
SELECT * FROM anofox_bayes_fit(
    (SELECT x, y FROM ok_data LIMIT 1), 'pooled_gaussian',
    {'y': 'y', 'x': 'x', 'draws': 500});
----
insufficient data

#######################################
# Degenerate input 6: an empty relation
#######################################

query I
SELECT anofox_bayes_is_actionable(param, value)
FROM anofox_bayes_fit((SELECT grp, v FROM solo WHERE false), 'conjugate_anomaly',
                      {'value': 'v', 'group': 'grp', 'draws': 1000});
----
false

#######################################
# Degenerate input 7: every value NULL
#######################################

query I
SELECT anofox_bayes_is_actionable(param, value)
FROM anofox_bayes_fit(
    (SELECT NULL::DOUBLE AS v FROM generate_series(1, 20)), 'conjugate_anomaly',
    {'value': 'v', 'draws': 1000});
----
false

#######################################
# Degenerate input 8: a sampling budget too small for the diagnostics
#######################################

query I
SELECT anofox_bayes_is_actionable(param, value)
FROM anofox_bayes_fit((SELECT x, y FROM ok_data), 'pooled_gaussian',
                      {'y': 'y', 'x': 'x', 'draws': 50});
----
false

#######################################
# The invariant: no NaN ever reaches SQL
#######################################

# Across every degenerate case above, a value is either a real number or NULL. A NaN
# would compare false against every threshold, so a gate written as `value > limit`
# would silently pass it -- which is precisely the silent-bad-number failure this
# whole path exists to prevent.
query I
SELECT bool_and(value IS NULL OR isfinite(value)) FROM (
    SELECT value FROM anofox_bayes_fit((SELECT grp, v FROM solo), 'conjugate_anomaly',
                                       {'value': 'v', 'group': 'grp', 'draws': 200})
    UNION ALL
    SELECT value FROM anofox_bayes_fit((SELECT v FROM constant), 'conjugate_anomaly',
                                       {'value': 'v', 'draws': 200})
    UNION ALL
    SELECT value FROM anofox_bayes_fit((SELECT x, y FROM perfect), 'pooled_gaussian',
                                       {'y': 'y', 'x': 'x', 'draws': 200})
    UNION ALL
    SELECT value FROM anofox_bayes_fit((SELECT NULL::DOUBLE AS v FROM generate_series(1, 20)),
                                       'conjugate_anomaly', {'value': 'v', 'draws': 200})
);
----
true

#######################################
# Config errors are precise and pre-computational
#######################################

statement error
SELECT * FROM anofox_bayes_fit((SELECT x, y FROM ok_data), 'pooled_gaussian', {'x': 'x'});
----
'y': is required

statement error
SELECT * FROM anofox_bayes_fit((SELECT x, y FROM ok_data), 'pooled_gaussian',
                               {'y': 'y', 'x': 'x', 'draws': -5});
----
between 4 and

statement error
SELECT * FROM anofox_bayes_fit((SELECT x, y FROM ok_data), 'pooled_gaussian',
                               {'y': 'y', 'x': 'x', 'seed': -1});
----
non-negative whole number

statement error
SELECT * FROM anofox_bayes_fit((SELECT x, y FROM ok_data), 'pooled_gaussian',
                               {'y': 'y', 'x': 'x', 'pool_scale': 0});
----
must be > 0

#######################################
# Decision macros
#######################################

statement ok
CREATE TABLE eff AS
SELECT * FROM anofox_bayes_fit((SELECT x, y FROM ok_data), 'pooled_gaussian',
                               {'y': 'y', 'x': 'x', 'draws': 4000, 'seed': 5});

# The slope is 0.5 by construction. P(slope > 0) is 1; P(slope > 1) is 0.
query II
SELECT anofox_bayes_prob_greater(value, 0.0), anofox_bayes_prob_greater(value, 1.0)
FROM eff WHERE param = 'beta[x]' AND draw >= 0;
----
1.0	0.0

# A 90% credible interval brackets the truth and is narrower than a 99% one.
query II
SELECT anofox_bayes_credible_lower(value, 0.9) < 0.5
   AND anofox_bayes_credible_upper(value, 0.9) > 0.5 AS brackets_truth,
       anofox_bayes_credible_upper(value, 0.99) - anofox_bayes_credible_lower(value, 0.99)
     > anofox_bayes_credible_upper(value, 0.90) - anofox_bayes_credible_lower(value, 0.90)
       AS wider_is_wider
FROM eff WHERE param = 'beta[x]' AND draw >= 0;
----
true	true

# A service level is a quantile of the posterior, so raising the target raises the
# number -- monotonically, which a mean-plus-k-sigma rule only manages when the
# posterior happens to be symmetric.
query I
SELECT anofox_bayes_service_level_quantile(value, 0.50)
     < anofox_bayes_service_level_quantile(value, 0.95)
   AND anofox_bayes_service_level_quantile(value, 0.95)
     < anofox_bayes_service_level_quantile(value, 0.99)
FROM eff WHERE param = 'sigma' AND draw >= 0;
----
true

# prob_greater and prob_less partition the draws.
query I
SELECT abs(anofox_bayes_prob_greater(value, 0.5) + anofox_bayes_prob_less(value, 0.5) - 1.0) < 1e-9
FROM eff WHERE param = 'beta[x]' AND draw >= 0;
----
true
